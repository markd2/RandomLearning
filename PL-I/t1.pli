/* Thing 1 - an almagam of language trivia glommed together from "Programming
 * for Poets" (from Cornell, 1978).
 */


/* exercise - print inner and outer 10 of a list of 9 numbers (was 30, but that many is annoying */
program: procedure options (main);
    declare (value, i) decimal;

    loop: do i = 1 to 3;
        get list (value);
        put skip list (value);
        end loop;

    loop2: do i = 1 to 3;
        get list (value);
        end loop2;

    loop3: do i = 1 to 3;
        get list (value);
        put skip list (value);
        end loop3;

    end program;

