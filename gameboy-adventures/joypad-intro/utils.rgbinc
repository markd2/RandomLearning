if !def(UTILS_RGBINC)
def UTILS_RGBINC equ 1

include "../hardware.rgbinc"

; copy \2 into \1 through (a)
; e.g. copy [$FF84], 10
macro copy
    ld a, \2
    ld \1, a
endm

rsreset
def PAD_INPUT_CURRENT   rb 1
def sizeof_PAD_INPUT    rb 0


macro InitPadInput
    ld a, $FF   ; no keys held
    ld [\1 + PAD_INPUT_CURRENT], a
endm

; reads from buttons, stores into PAD_INPUT_CURRENT. Clobbers a and b
macro UpdatePadInput
    ; read the d-pad
    ld a, P1F_GET_DPAD
    ldh [rP1], a
    ldh a, [rP1]    ; prevent skids
    ldh a, [rP1]

    ; put the d-pad input into B's high nibbage
    swap a
    and a, $F0
    ld b, a

    ; read the butts
    ld a, P1F_GET_BTN
    ldh [rP1], a
    ldh a, [rP1]    ; prevent skids
    ldh a, [rP1]
    ldh a, [rP1]
    ldh a, [rP1]
    ldh a, [rP1]
    ldh a, [rP1]

    ; merge button's input with b's high nibbage, buttons into low nibbage
    and a, $0f
    or a, b

    ; store the current input
    ld [\1 + PAD_INPUT_CURRENT], a

    ; disable input polling
    ld a, P1F_GET_NONE
    ldh [rP1], a    
endm

; take a structure and input mask, and raises the zero flag 
; if all keys in the mask are held.  (down = clear bit)
macro TestPadInput_HeldAll
    ld a, [\1 + PAD_INPUT_CURRENT]
    and a, \2
endm


endc
