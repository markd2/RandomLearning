include "utils.rgbinc"

def TILES_COUNT			equ (384)
def BYTES_PER_TILE              equ (16)
def TILES_BYTE_SIZE             equ (TILES_COUNT * BYTES_PER_TILE)

def TILEMAPS_COUNT              equ (2)
def BYTES_PER_TILEMAP           equ (1024)
def TILEMAPS_BYTE_SIZE          equ (TILEMAPS_COUNT * BYTES_PER_TILEMAP)
def GRAPHICS_DATA_SIZE          equ (TILES_BYTE_SIZE + TILEMAPS_BYTE_SIZE)
def GRAPHICS_DATA_ADDRESS_END   equ ($8000)
def GRAPHICS_DATA_ADDRESS_START	\
    equ (GRAPHICS_DATA_ADDRESS_END - GRAPHICS_DATA_SIZE)


def WINDOW equ ($9C00)
def TILES equ ($8000)

def LINE_COUNT equ (3)    ; controlled by b

def WINDOW_TILE_ROW_COUNT equ (20)  ; controlled by c
def WINDOW_TILE_ROW_SKIP equ (12)   ; pointer math

; --------------------------------------------------
rsset _RAM   ; beginning of WRAM - $C000

; input struct
def WRAM_PAD_INPUT      rb sizeof_PAD_INPUT
def WRAM_FRAME_COUNTER  rb 1

; background scrolling
def WRAM_BG_SCX         rb 1
def WRAM_BG_SCY         rb 1

; window control
def WRAM_WIN_ENABLE_FLAG        rb 1

def WRAM_CHANNEL_VOLUME         rb 1
def WRAM_STEP_LENGTH    rb 1

def WRAM_STOP_COUNTER    rb 1

def WRAM_END                    rb 0

def WRAM_USAGE     equ (WRAM_END - _RAM)
println "WRAM usage: {d:WRAM_USAGE} bytes"
assert WRAM_USAGE <= $2000, "Too much bytes in WRAM waah"
; --------------------------------------------------



macro LoadGraphicsDataIntoVRAM
    ld de, GRAPHICS_DATA_ADDRESS_START
    ld hl, _VRAM8000
    .load_tile\@
        ld a, [de]
        inc de
        ld [hli], a
        ld a, d
        ; don't really care about low byte, just the transition to highbyte $80
        cp a, high(GRAPHICS_DATA_ADDRESS_END)
        jr nz, .load_tile\@
endm

macro InitOAM
    ld c, OAM_COUNT
    ; Set the Y of every sprite to zero - that puts it off the top of the visible
    ; screen - otherwise we'll get omelette du garbage of sprites.
    ; Don't need to initialize :all-the-things: - enough to shove it off screen
    ; so it won't get drawn. If it won't get drawn, who cares what the other
    ; configurations are?
    ld hl, _OAMRAM + OAMA_Y
    ld de, sizeof_OAM_ATTRS
    .init_oam\@
        ld [hl], 0
        add hl, de
        dec c
        jr nz, .init_oam\@
endm


section "vblank_interrupt", rom0[$0040]
    reti

section "sample", rom0

InitSample:
    ; initialize WRAM state
    InitPadInput WRAM_PAD_INPUT
    copy [WRAM_FRAME_COUNTER], $FF
    copy [WRAM_STOP_COUNTER], 0

    ; setup sound stuffage
    copy [rNR52], AUDENA_ON
    copy [rNR50], $77
    copy [rNR51], $FF

    xor a
    ld [WRAM_BG_SCX], a
    ld [WRAM_BG_SCY], a
    ld [WRAM_WIN_ENABLE_FLAG], a

    ; set palette(s)
    ld a, %11100100
    ld [rBGP], a
    ld [rOBP0], a    ; first sprite palette
    ld a, %00011011
    ld [rOBP1], a    ; second sprite palette

    LoadGraphicsDataIntoVRAM
    InitOAM

    ; place the window at the bottom of the LCD
    ld a, 7
    ld [rWX], a
    ld a, 120
    ld [rWY], a

    ; turn LCD on plus flags
    ld a, LCDCF_ON | LCDCF_WINON | LCDCF_WIN9C00 | \
          LCDCF_BG8800 | LCDCF_BG9800 | LCDCF_OBJ16 | LCDCF_OBJON | LCDCF_BGON
    ld [rLCDC], a

    ld a, IEF_VBLANK
    ld [rIE], a
    ei
    ret

UpdateSample:
    halt

    ; set the background position
;    copy [rSCX], [WRAM_BG_SCX]
;   copy [rSCY], [WRAM_BG_SCY]
    
    ; toggule window on/off
    ldh a, [rLCDC]     ; get current LCD control
    and a, ~LCDCF_WINON  ; clear the flag
    ld hl, WRAM_WIN_ENABLE_FLAG ; load our setting
    or a, [hl]   ; if it's on, will set flag, likewise other way
    ldh [rLCDC], a   ; set LCD control with (potentially) updated flag


    ; set up first sprite
def SPRITE_0_INDEX equ (16)
def SPRITE_0_ADDRESS equ (_OAMRAM)
    copy [SPRITE_0_ADDRESS + OAMA_X], 16
    copy [SPRITE_0_ADDRESS + OAMA_Y], 32
    copy [SPRITE_0_ADDRESS + OAMA_TILEID], SPRITE_0_INDEX
    copy [SPRITE_0_ADDRESS + OAMA_FLAGS], OAMF_PAL0

def SPRITE_1_INDEX equ (0)
def SPRITE_1_ADDRESS equ (_OAMRAM + sizeof_OAM_ATTRS)
    copy [SPRITE_1_ADDRESS + OAMA_X], 80
    copy [SPRITE_1_ADDRESS + OAMA_Y], 80
    copy [SPRITE_1_ADDRESS + OAMA_TILEID], SPRITE_1_INDEX
    copy [SPRITE_1_ADDRESS + OAMA_FLAGS], OAMF_PAL0 | OAMF_XFLIP

IF 0
roll_sprite_tiles:
    ; change sprite tiles in code
    ld hl, TILES
    ld b, BYTES_PER_TILE
.loop3:
    ld a, [hl]
    rrca
    ld [hl+], a
    dec b
    jr nz, .loop3

    ; they're 2x tall, so muck with the next tile
    ld hl, TILES + BYTES_PER_TILE
    ld b, BYTES_PER_TILE
.loop4:
    ld a, [hl]
    rlca    ; OTHER WAY! DO THE TWIST!
    ld [hl+], a
    dec b
    jr nz, .loop4


ENDC

IF 0
scroll_window:
    ; scroll window by mucking with rWX / rWY
    ld a, [rWX]
    inc a
    cp a, 160
    jr nz, .use_x_value
    ld a, 0
.use_x_value
    ld [rWX], a

    ld a, [rWY]
    inc a
    inc a
    cp a, 160
    jr nz, .use_y_value
    ld a, 0
.use_y_value
    ld [rWY], a
ENDC

IF 0
cycle_sprite_palette_zero:
    ; muck with color of sprite palette index zero (The transparancy one)
    ; a misunderstanding (and learning opp) - the index zero used in sprites
    ; for transparency has no relation to the OBP0, whose bottom two bits
    ; are ignored.
    ld a, [rOBP0]
    and a, $FC    ; clear bottom two bits
    ld c, a       ; stuff it away
    ld a, [rOBP0]
    add a, 1      ; add. don't care about carry
    and $03       ; mask off all but the top bits leaving index zero
    add a, c      ; bring in higher bits
    ld [rOBP0], a ; update sprite palette
ENDC

IF 0
hand_made_tile:
    jr .code
.tile:  ; hand-calculated happy face with a hat.
    dw $3C00
    dw $FF00
    dw $007E
    dw $247E
    dw $007E
    dw $427E
    dw $3C7E
    dw $0018
.code:
    ld de, .tile      ; copy from
    ld hl, _VRAM8000  ; copy to
    ld c, 16          ; dis many bytes
.move:
    ld a, [de]
    inc de
    ld [hli], a
    dec c
    jr nz, .move
ENDC

IF 0
infinite_scroll:
    ; infinite scroll
    ld a, [rSCX]
    inc a
    ld [rSCX], a

    ld a, [rSCY]
    inc a
    inc a
    ld [rSCY], a
ENDC

IF 0
rotate_tiles:
    ; rotate the tiles (not the indexes themselves) so it does a barberpole
    ld b, LINE_COUNT
    ld hl, WINDOW   ; point to start of line

.loop2:
    ; starts at start of current line

    ; point to end of visible window tiles
    ld de, WINDOW_TILE_ROW_COUNT - 1
    add hl, de

    ; snarf the last one and put it on the stack
    ld a, [hl]
    ld d, 0
    ld e, a     ; de (16 bits, ripe for pushing) is 00INDX
    push de

    ; *scan = *scan-- the rest of the loop
    ld c, WINDOW_TILE_ROW_COUNT - 1
.line_loop2:
    dec hl      ; *scan--
    ld a, [hl]  ; a = *scan
    inc hl      ; *scan++
    ld [hl], a  ; *scan = a
    dec hl      ; *scan--

    dec c
    jr nz, .line_loop2


    ; hl should now be pointing at the first tile of the line.
    ; pop off the stack and put that savdd index into position
    pop de
    ld [hl], e

    ; hl still pointing at beginning of the line
    ; scoot it to the next line
    ld de, WINDOW_TILE_ROW_COUNT + WINDOW_TILE_ROW_SKIP
    add hl, de

    dec b
    jr nz, .loop2
ENDC

IF 0
rotate_window_tile_indexes:
    ; muck with window contents by rotating the index in-place
    ; b is the line count (3,2,1, break at zero)
    ; hl is the scan starting at the tilemap start ($9C00)
    ; a loop increments from 20 to 1, break at zero. That's a line
    ;   c is that counter
    ; hl += 12 skipping over off-screen tiles
    ; do the next line
    
    ld b, LINE_COUNT

    ; start scan at beginning of the window's tile memory
    ld hl, WINDOW

.loop1

    ld c, WINDOW_TILE_ROW_COUNT
.line_loop1:
    ld a, [hl]    ; *scan
    rrca          ; mutate
    ld [hli], a   ; *scan++ = a
    dec c
    jr nz, .line_loop1

    ; skip the unused rest of the tilemap row
    ld de, WINDOW_TILE_ROW_SKIP
    add hl, de

    dec b
    jr nz, .loop1

ENDC

IF 0
roll_bg_palette:
    ; roll the bg palette continually to the right.  VERY trippy
    ld a, [rBGP]  ; get current
    rrca  ; roll out the barrel
    rrca  ; roll out the barrel  - by two-bit color
    ld [rBGP], a
ENDC

    ; ------------------------------
    ; non VBLANK logic, set values to be picked up on next redraw
    UpdatePadInput WRAM_PAD_INPUT

    ; d-paddle check
    TestPadInput_HeldAll WRAM_PAD_INPUT, PADF_LEFT
    jr nz, .left_checked
        ld hl, WRAM_BG_SCX
        dec [hl]
    .left_checked

    TestPadInput_HeldAll WRAM_PAD_INPUT, PADF_RIGHT
    jr nz, .right_checked
        ld hl, WRAM_BG_SCX
        inc [hl]
    .right_checked

    TestPadInput_HeldAll WRAM_PAD_INPUT, PADF_UP
    jr nz, .up_checked
        ld hl, WRAM_BG_SCY
        dec [hl]
    .up_checked

    TestPadInput_HeldAll WRAM_PAD_INPUT, PADF_DOWN
    jr nz, .down_checked
        ld hl, WRAM_BG_SCY
        inc [hl]
    .down_checked

    ; window toggule
    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_A
    jr nz, .window_toggle_checked
        ld a, [WRAM_WIN_ENABLE_FLAG]
        cpl
        and a, LCDCF_WINON
        ld [WRAM_WIN_ENABLE_FLAG], a
    .window_toggle_checked

; play bling
IF 0
    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_A
    jr nz, .no_start_sound_1
        ; play sound 1
        copy [rNR10], $00
        copy [rNR11], $80
        copy [rNR12], $F3
        copy [rNR13], $83
        copy [rNR14], $87
        ; activate counter to play sound 2 after a delay
        copy [WRAM_FRAME_COUNTER], 4
    .no_start_sound_1

    ; skip counter check if the counter is disabled ($FF)
    ld a, $FF
    ld hl, WRAM_FRAME_COUNTER
    cp a, [hl]
    jr nz, .no_trigger_sound_2
        ; play sound 2 when counter reaches zero
        dec [hl]
        jr nz, .no_trigger_sound_2
            ; play sound 2
            copy [rNR10], $00
            copy [rNR11], $80
            copy [rNR12], $F3
            copy [rNR13], $C1
            copy [rNR14], $87
            ; deactivate counter
            dec [hl]
    .no_trigger_sound_2
ENDC

; Play C (A button) or A (B button) 4  - frequency
IF 0
    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_A
    jr nz, .button_a
        ld de, $C60B
        jr .play_sound
    .button_a

    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_B
    jr nz, .button_b
        ld de, $C6D6
        jr .play_sound
    .button_b

    .play_sound
    copy [rNR10], $00
    copy [rNR11], $80
    copy [rNR12], $F0
    copy [rNR13], e
    copy [rNR14], d
ENDC

; duty cycle with d-pad
IF 0
   TestPadInput_Pressed WRAM_PAD_INPUT, PADF_LEFT
   jr nz, .left
       copy [rNR11], $00
       jr .play_sound
   .left

   TestPadInput_Pressed WRAM_PAD_INPUT, PADF_UP
   jr nz, .up
       copy [rNR11], $40
       jr .play_sound
   .up

   TestPadInput_Pressed WRAM_PAD_INPUT, PADF_RIGHT
   jr nz, .right
       copy [rNR11], $80
       jr .play_sound
   .right

   TestPadInput_Pressed WRAM_PAD_INPUT, PADF_DOWN
   jr nz, .down
       copy [rNR11], $C0
       jr .play_sound
   .down

   .play_sound
   copy [rNR10], $00
   copy [rNR12], $F0
   copy [rNR13], $0B
   copy [rNR14], $C6
ENDC

; note length with dpad
IF 0
.noteLengthDPAD

def PLAY_FLAG_ROW   equ (8)
def PLAY_FLAG_COLUMN equ (12)
def TILE_INDEX_ZERO  equ (80)

    ; vblank
    ld hl, _SCRN0 + PLAY_FLAG_ROW * SCRN_VX_B + PLAY_FLAG_COLUMN
    ld [hl], TILE_INDEX_ZERO

    ld a, [rNR52]
    bit 0, a
    jr z, .play_flag
        ld [hl], TILE_INDEX_ZERO + 1
    .play_flag

    ; udderwise
    ld c, $40

    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_LEFT
    jr nz, .left
        ld b, $00
        ld c, $00
        jr .play_sound
    .left

    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_UP
    jr nz, .up
        ld b, $3C  ; c is $40
        jr .play_sound
    .up

    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_RIGHT
    jr nz, .right
        ld b, $31  ; c is $40
        jr .play_sound
    .right

    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_DOWN
    jr nz, .down
        ld b, $00  ; c is $40
        jr .play_sound
    .down
.returnLabel
    ret

    .play_sound
    copy [rNR10], $00

    ld a, $80
    or a, b
    ld [rNR11], a

    copy [rNR12], $F0
    copy [rNR13], $0B

    ld a, $86
    or a, c
    ld [rNR14], a

ENDC

; loudness - left/right terminal L/R on dpad.  Up/down channel. A plays
IF 0
def TILE_INDEX_ZERO  equ (80)
def TILE_INDEX_A   equ (97)

def TERMINAL_LEFT_TILE_ADDRESS equ (_SCRN0 + 4 * SCRN_VX_B + 10)
def TERMINAL_RIGHT_TILE_ADDRESS equ (_SCRN0 + 5 * SCRN_VX_B + 10)
def CHANNEL_TILE_ADDRESS equ (_SCRN0 + 8 * SCRN_VX_B + 11)

    ; vblank stuff
    ; left terminal volume
    ld a, [rNR50]
    swap a
    and a, $07
    add a, TILE_INDEX_ZERO
    ld hl, TERMINAL_LEFT_TILE_ADDRESS
    ld [hl], a

    ; left terminal volume
    ld a, [rNR50]
    and a, $07
    add a, TILE_INDEX_ZERO
    ld hl, TERMINAL_RIGHT_TILE_ADDRESS
    ld [hl], a

    ; channel volume
    ld a, [WRAM_CHANNEL_VOLUME]
    swap a
    and a, $0F
    cp a, 10
    jr c, .compare_to_ten
        sub a, 10
        add a, TILE_INDEX_A
        ld hl, CHANNEL_TILE_ADDRESS
        ld [hl], a
        jr .compare_to_ten_end
    .compare_to_ten
        add a, TILE_INDEX_ZERO
        ld hl, CHANNEL_TILE_ADDRESS
        ld [hl], a
    .compare_to_ten_end

    ; udder stuff
    ; cycle through left termina';s volumes
    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_LEFT
    jr nz, .left
        ld a, [rNR50]
        swap a
        inc a
        and a, $07
        swap a
        ld b, a

        ld a, [rNR50]
        and a, $8F
        or a, b
        ld [rNR50], a
    .left

    ; cycle through left termina';s volumes
    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_RIGHT
    jr nz, .right
        ld a, [rNR50]
        inc a
        and a, $07
        ld b, a

        ld a, [rNR50]
        and a, $F8
        or a, b
        ld [rNR50], a
    .right

    ; increase the channel volume and loop to $00 if overflow
    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_UP
    jr nz, .up
        ld a, [WRAM_CHANNEL_VOLUME]
        swap a
        inc a
        and a, $0F
        swap a
        ld [WRAM_CHANNEL_VOLUME], a
    .up

    ; decrease hte channel volume and loop to $0F if overflow
    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_DOWN
    jr nz, .down
        ld a, [WRAM_CHANNEL_VOLUME]
        swap a
        dec a
        and a, $0F
        swap a
        ld [WRAM_CHANNEL_VOLUME], a
    .down

    ; play a sound with proper channel volume
    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_A
    jr nz, .play_sound
        copy [rNR10], $0
        copy [rNR11], $80
        copy [rNR12], [WRAM_CHANNEL_VOLUME]
        copy [rNR13], $0B
        copy [rNR14], $C6
    .play_sound

ENDC

; envelope fun.  A: play sound.  up/down, change envelope step length
IF 0
def STEP_LENGTH_TILE_ADDRESS equ (_SCRN0 + 6 * SCRN_VX_B + 12)
def TILE_INDEX_ZERO equ (80)

    ; vblank stuff
    ld a, [WRAM_STEP_LENGTH]
    add a, TILE_INDEX_ZERO
    ld [STEP_LENGTH_TILE_ADDRESS], a

    ; logic stuff
    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_UP
    jr nz, .up
        ld a, [WRAM_STEP_LENGTH]
        inc a
        and a, $07
        ld [WRAM_STEP_LENGTH], a
    .up

    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_DOWN
    jr nz, .down
        ld a, [WRAM_STEP_LENGTH]
        dec a
        and a, $07
        ld [WRAM_STEP_LENGTH], a
    .down

    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_A
    jr nz, .play_sound
        copy [rNR10], $00
        copy [rNR11], $80

        ld a, [WRAM_STEP_LENGTH]
        or a, $F0
        ld [rNR12], a
        
        copy [rNR13], $08
        copy [rNR14], $86
    .play_sound
ENDC

IF 1
; play frequency sleep.  A for Add, B for Subtract
    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_A
    jr nz, .play_sound_add
        copy [rNR10], $45
        copy [rNR11], $80
        copy [rNR12], $F0
        copy [rNR13], $0B
        copy [rNR14], $86
    .play_sound_add

    TestPadInput_Pressed WRAM_PAD_INPUT, PADF_B
    jr nz, .play_sound_subtract
        copy [rNR10], $4E
        copy [rNR11], $80
        copy [rNR12], $F0
        copy [rNR13], $E1
        copy [rNR14], $87
    .play_sound_subtract

    ; stop the sound when counter reaches zero to avoid infinite sound
    ld a, [WRAM_STOP_COUNTER]
    inc a
    ld [WRAM_STOP_COUNTER], a
    jr nz, .stop_sound
        copy [rNR10], $00
        copy [rNR11], $3F
        copy [rNR12], $00
        copy [rNR13], $00
        copy [rNR14], $C0
    .stop_sound
ENDC
; !!! HERE

    ret

export InitSample
export UpdateSample

section "graphics_data", rom0[GRAPHICS_DATA_ADDRESS_START]
incbin "tileset.chr"
incbin "background.tlm"
incbin "window.tlm"

